# Copy to .env and fill in. Every value is optional for local development.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
# e.g. https://app.tablex.in (needed for Django admin forms behind HTTPS)
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database: SQLite by default; set DB_ENGINE=postgres for PostgreSQL ---
DB_ENGINE=sqlite
DB_FILE=db.sqlite3
# DB_NAME=tablex
# DB_USER=tablex
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Public URL used inside table QR codes (defaults to the address in the browser)
APP_URL=

# --- Super Admin created on first `migrate` (change the password after signing in) ---
SUPERADMIN_NAME=TableX Super Admin
SUPERADMIN_PHONE=9000000000
SUPERADMIN_EMAIL=admin@tablex.app
SUPERADMIN_PASSWORD=ChangeMe@123

# --- Razorpay: platform account for restaurant plan purchases ---
# Leave empty to run payments in clearly-labelled DEMO mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Set to false in production
ALLOW_DEMO_PAYMENTS=true

# Free-trial days for newly onboarded restaurants (0 = none)
TRIAL_DAYS=14
