# Copy this file to .env and fill in your values.

PORT=8080
# Public URL of the app — used in table QR codes (e.g. https://app.tablex.in)
APP_URL=http://localhost:8080
# SQLite database file
DB_FILE=data/tablex.db

# Super Admin account created on first start (change the password after signing in)
SUPERADMIN_NAME=TableX Super Admin
SUPERADMIN_PHONE=9000000000
SUPERADMIN_EMAIL=admin@tablex.app
SUPERADMIN_PASSWORD=ChangeMe@123

# Razorpay — platform account used for restaurant subscription purchases.
# Leave empty to run payments in clearly-labelled DEMO mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set to "false" in production to refuse demo payments when keys are missing.
ALLOW_DEMO_PAYMENTS=true

# Days of free trial given to newly onboarded restaurants (0 = none)
TRIAL_DAYS=14
